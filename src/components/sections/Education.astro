---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { education, testimonial } from '../../data/education';
import avatar from '../../assets/images/testimonial-odikie.jpg';
---

<Section
  id="education"
  model="mortarboard"
  index="06"
  label="Education"
  meta={['1 degree', `${education.length - 1} programmes`]}
  title="Always studying."
>
  <ul class="grid grid-cols-1 border-t border-l border-line sm:grid-cols-2 2xl:grid-cols-4">
    {
      education.map((e, i) => (
        <li class="flex flex-col border-r border-b border-line p-6 sm:p-7" data-reveal style={`--reveal-delay: ${(i % 2) * 70}ms`}>
          <p class="label">{e.period}</p>
          <h3 class="mt-5 font-display text-2xl font-bold tracking-tight">{e.title}</h3>
          <p class="mt-1">
            {e.url ? (
              <a href={e.url} target="_blank" rel="noopener noreferrer" class="link">
                {e.institution}
              </a>
            ) : (
              e.institution
            )}
          </p>
          <p class="mt-3 text-sm text-muted">{e.detail}</p>
          {e.link && (
            <a
              href={e.link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link mt-auto inline-flex w-fit items-center gap-1 pt-5 font-mono text-xs"
            >
              {e.link.label} <Icon name="ArrowUpRight" size={13} />
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <figure class="mt-20 grid grid-cols-1 gap-6 md:grid-cols-9 md:gap-8" data-reveal>
    <p class="label md:col-span-2">Kind words</p>
    <div class="md:col-span-7">
      <blockquote class="display text-[clamp(1.9rem,4.5vw,3.25rem)] leading-[1.02] [font-stretch:100%]">
        <span class="text-accent">“</span>{testimonial.quote}<span class="text-accent">”</span>
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-3">
        <Image src={avatar} alt="" width={48} height={48} class="size-11 rounded-full object-cover grayscale" />
        <div>
          <p class="font-medium">{testimonial.author}</p>
          <p class="text-sm text-muted">{testimonial.title}</p>
        </div>
      </figcaption>
    </div>
  </figure>
</Section>
