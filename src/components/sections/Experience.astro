---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { experience } from '../../data/experience';
---

<Section
  id="experience"
  model="neural"
  index="02"
  label="Experience"
  meta={[`${experience.length} roles`, '2023 → now']}
  title="Where I've worked."
  intro="From shipping product UIs to building the data that trains and grades AI models."
>
  <ol class="border-t border-line">
    {
      experience.map((job, i) => (
        <li
          class="group grid grid-cols-1 gap-x-8 gap-y-3 border-b border-line py-8 md:grid-cols-9 xl:grid-cols-12"
          data-reveal
          style={`--reveal-delay: ${i * 50}ms`}
        >
          <div class="md:col-span-2 xl:col-span-2">
            <p class="font-mono text-sm">{job.period}</p>
            <p class="label mt-1">{job.type}</p>
          </div>
          <div class="md:col-span-7 xl:col-span-7">
            <h3 class="font-display text-2xl font-bold tracking-tight [font-stretch:105%] sm:text-3xl">
              {job.role}
              <span class="font-normal text-muted"> — </span>
              {job.companyUrl ? (
                <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="link inline-flex items-baseline gap-1 font-normal">
                  {job.company}
                  <Icon name="ArrowUpRight" size={18} class="self-center" />
                </a>
              ) : (
                <span class="font-normal">{job.company}</span>
              )}
            </h3>
            <p class="mt-3 max-w-2xl text-muted">{job.summary}</p>
            {job.highlights.length > 0 && (
              <ul class="mt-4 max-w-2xl space-y-2 text-muted">
                {job.highlights.map((h) => (
                  <li class="grid grid-cols-[1.25rem_1fr]">
                    <span class="text-accent">—</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <ul class="flex flex-wrap content-start gap-1.5 md:col-span-7 md:col-start-3 xl:col-span-3 xl:col-start-auto xl:justify-end" aria-label="Skills used">
            {job.stack.map((s) => (
              <li class="tag">{s}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
