---
// MARKUP ONLY. The 404 page's shell. Same engine and commands as the hero terminal (lib/terminal/shell.ts).
import { site } from '../config/site';
import { getTerminalData } from '../lib/terminal/data';

const data = await getTerminalData();
---

<div data-terminal data-mode="404" class="border border-line bg-black/50 font-mono text-[13px] leading-6 backdrop-blur-sm">
  <div class="flex items-center justify-between border-b border-line px-4 py-2 text-xs text-muted">
    <span>{site.handle}: 404 shell</span>
    <span data-term-status class="text-accent">scanning…</span>
  </div>

  <div data-term-output data-term-body class="max-h-[320px] min-h-[220px] overflow-y-auto px-4 py-3" aria-live="polite"></div>

  <form class="flex items-center gap-2 border-t border-line px-4 py-3" autocomplete="off">
    <label for="shell-input" class="whitespace-nowrap">
      <span class="text-accent">{site.handle}@portfolio</span><span class="text-muted">:<span data-term-cwd>~</span>$</span>
      <span class="sr-only">Terminal command</span>
    </label>
    <input
      id="shell-input"
      data-term-input
      type="text"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="send"
      placeholder="type help"
      class="min-w-0 flex-1 bg-transparent text-inherit outline-none placeholder:text-muted/60"
    />
  </form>

  <script type="application/json" data-term-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</div>

<style>
  [data-terminal]:focus-within {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }
</style>

<script>
  import { mountAll } from '../lib/terminal/shell';
  mountAll();
</script>
